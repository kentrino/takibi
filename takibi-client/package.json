{
  "name": "@takibi/takibi-client",
  "version": "0.0.0",
  "description": "Typed HTTP client for Takibi collections and actions.",
  "keywords": [
    "client",
    "http",
    "takibi",
    "typescript"
  ],
  "homepage": "https://github.com/diaree/takibi/tree/HEAD/packages/takibi-client",
  "bugs": {
    "url": "https://github.com/diaree/takibi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diaree/takibi.git",
    "directory": "packages/takibi-client"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "@takibi/takibi-api": "workspace:^",
    "@takibi/takibi-policy": "workspace:^",
    "@takibi/takibi-protocol": "workspace:^",
    "@takibi/takibi-query": "workspace:^",
    "@takibi/takibi-shared-types": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
