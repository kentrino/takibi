{
  "name": "takibi-monorepo",
  "private": true,
  "description": "Typed multi-tenant collection store on Cloudflare Durable Objects.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "vp check",
    "ready": "vp run check && vp run -r test && vp run -r build",
    "test:e2e": "pnpm --filter takibi-e2e test:e2e",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "publint": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.20.0"
}
