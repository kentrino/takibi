{
  "name": "@takibi/takibi",
  "version": "0.0.0",
  "private": true,
  "description": "Typed multi-tenant collection store on Cloudflare Durable Objects.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client-entry.ts",
    "./otel": "./src/otel.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test && vp run test:workers",
    "test:workers": "vp test --config vite.workers.config.ts",
    "check": "vp check"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "^4.20250803.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.2.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  }
}
