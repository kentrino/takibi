{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "takibi-storage-tests",
  "main": "./tests/worker.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "TAKIBI_STORAGE_TEST",
        "class_name": "StorageTestObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StorageTestObject"],
    },
  ],
}
