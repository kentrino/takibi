{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "takibi-realtime-chat",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOMS",
        "class_name": "ChatRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"],
    },
  ],
}
