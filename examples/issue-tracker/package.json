{
  "name": "@takibi/issue-tracker",
  "version": "0.0.0",
  "private": true,
  "description": "Example issue-tracker app used by benchmarks, packed-package e2e, and the containerized full-path scenario.",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node scripts/pack.ts",
    "build:test": "ISSUE_TRACKER_PACK=tests vp pack",
    "dev": "vp pack --watch",
    "test": "pnpm run build && pnpm run build:test && node --test --test-timeout=30000 dist/*.test.mjs",
    "check": "vp check"
  },
  "dependencies": {
    "@takibi/hono-adapter": "workspace:^",
    "hono": "catalog:",
    "takibi": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
