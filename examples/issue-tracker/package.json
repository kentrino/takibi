{
  "name": "@takibi/issue-tracker",
  "version": "0.0.0",
  "private": true,
  "description": "Example issue-tracker app used by benchmarks, packed-package e2e, and the app-image full-path test.",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp pack && node --test --test-timeout=30000 dist/*.test.mjs",
    "check": "vp check"
  },
  "dependencies": {
    "@takibi/hono-adapter": "workspace:^",
    "hono": "catalog:",
    "takibi": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "inlinedDependencies": {
    "@noble/hashes": "2.4.0",
    "@standard-schema/spec": "1.1.0",
    "hono": "4.13.7",
    "tatenuki": "0.2.0",
    "zod": "4.6.1"
  }
}
