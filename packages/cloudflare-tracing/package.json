{
  "name": "@takibi/cloudflare-tracing",
  "version": "0.0.0",
  "description": "Cloudflare Workers native tracing adapter for takibi.",
  "keywords": [
    "cloudflare",
    "takibi",
    "tracing",
    "workers"
  ],
  "homepage": "https://github.com/kentrino/takibi/tree/HEAD/packages/cloudflare-tracing",
  "bugs": {
    "url": "https://github.com/kentrino/takibi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kentrino/takibi.git",
    "directory": "packages/cloudflare-tracing"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test && vp run test:workers",
    "test:workers": "vp test --config vite.workers.config.ts",
    "check": "vp check"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "^4.20250803.0",
    "@types/node": "catalog:",
    "takibi": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "takibi": "workspace:^"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
