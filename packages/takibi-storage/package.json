{
  "name": "@takibi/takibi-storage",
  "version": "0.0.0",
  "description": "Durable Object SQLite storage engine for Takibi.",
  "keywords": [
    "durable-objects",
    "sqlite",
    "storage",
    "takibi"
  ],
  "homepage": "https://github.com/kentrino/takibi/tree/HEAD/packages/takibi-storage",
  "bugs": {
    "url": "https://github.com/kentrino/takibi/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kentrino/takibi.git",
    "directory": "packages/takibi-storage"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test && vp run test:workers",
    "test:workers": "vp test --config vite.workers.config.ts",
    "check": "vp check"
  },
  "dependencies": {
    "@takibi/takibi-api": "workspace:^",
    "@takibi/takibi-protocol": "workspace:^",
    "@takibi/takibi-query": "workspace:^",
    "@takibi/takibi-shared-types": "workspace:^",
    "@takibi/takibi-utility": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "^4.20250803.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
