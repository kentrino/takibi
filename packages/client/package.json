{
  "name": "@takibi/client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed HTTP client for Takibi collections and actions.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "@takibi/api": "workspace:^",
    "@takibi/policy": "workspace:^",
    "@takibi/protocol": "workspace:^",
    "@takibi/query": "workspace:^",
    "@takibi/shared-types": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
